[Unit]
Description=DAIINAS read-only scanner and simulated paper account
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=daiinas
Group=daiinas
WorkingDirectory=/opt/daiinas
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m daiinas.service run --db /var/lib/daiinas/paper.sqlite3 --config /opt/daiinas/configs/service.json --rules-file /var/lib/daiinas/exchangeInfo.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=420
StateDirectory=daiinas
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/daiinas
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
