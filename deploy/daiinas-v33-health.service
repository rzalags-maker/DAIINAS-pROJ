[Unit]
Description=DAIINAS v3.3 read-only health probe

[Service]
Type=oneshot
User=daiinas
Group=daiinas
WorkingDirectory=/opt/daiinas
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/daiinas/.venv/bin/python -m daiinas.continuous status --source-db /var/lib/daiinas-v33/source.sqlite3 --paper-db /var/lib/daiinas-v33/paper.sqlite3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/daiinas-v33
