[Unit]
Description=DAIINAS v3.3 continuous dynamic PAPER service - LIVE ORDERS DISABLED
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=daiinas
Group=daiinas
WorkingDirectory=/opt/daiinas
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/daiinas/.venv/bin/python -m daiinas.continuous run --config /opt/daiinas/configs/continuous.json --source-db /var/lib/daiinas-v33/source.sqlite3 --paper-db /var/lib/daiinas-v33/paper.sqlite3 --report /var/lib/daiinas-v33/last-run.json
StateDirectory=daiinas-v33
UMask=0077
Restart=on-failure
RestartSec=15
TimeoutStopSec=90
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/daiinas-v33
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
